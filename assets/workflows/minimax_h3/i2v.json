{
  "_studio": {
    "bindings": {
      "positive": [
        "h3_i2v.inputs.prompt"
      ],
      "width": [
        "h3_i2v.inputs.width"
      ],
      "height": [
        "h3_i2v.inputs.height"
      ],
      "length_frames": [
        "h3_i2v.inputs.length"
      ],
      "fps": [
        "create_video.inputs.fps"
      ],
      "seed": [
        "noise.inputs.noise_seed"
      ]
    },
    "source": "douyin-video-studio/validated_workflows/minimax_h3/i2v_api.json",
    "bindings_verified": true
  },
  "load_unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "sigmashift": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "load_unet",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "load_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "h3_i2v": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "load_clip",
        0
      ],
      "vae": [
        "vae_video",
        0
      ],
      "prompt": "<Picture 1> is the first frame and <Picture 2> is the final frame. The same red paper lantern sways gently to the right in one continuous shot, quiet studio, no text, no logo.",
      "width": 160,
      "height": 288,
      "length": 22,
      "first_frame": [
        "load_first",
        0
      ],
      "last_frame": [
        "load_last",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 46
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "sigmashift",
        0
      ],
      "conditioning": [
        "h3_i2v",
        0
      ]
    }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "sigmashift",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "sampler_sel": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler_sel",
        0
      ],
      "sigmas": [
        "scheduler",
        0
      ],
      "latent_image": [
        "h3_i2v",
        1
      ]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae_video",
        0
      ]
    }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae_audio",
        0
      ]
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decode_video",
        0
      ],
      "fps": 24.0,
      "audio": [
        "decode_audio",
        0
      ]
    }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "create_video",
        0
      ],
      "filename_prefix": "validation/minimax_h3/i2v",
      "format": "auto",
      "codec": "auto"
    }
  },
  "load_first": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "validation_start.png"
    }
  },
  "load_last": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "validation_end.png"
    }
  }
}
