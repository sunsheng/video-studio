{
  "_studio": {
    "bindings": {
      "filename": ["load.inputs.file"],
      "width": ["resize.inputs.resize_type.width"],
      "height": ["resize.inputs.resize_type.height"],
      "seed": ["sampler.inputs.seed"],
      "output_prefix": ["save.inputs.filename_prefix"]
    },
    "role": "post_upscale",
    "source": "Comfy-Org/workflow_templates templates/utility_seedvr2_3b_int8_upscale_video.json（definitions.subgraphs[0] 展平，权重换成 7B）",
    "source_run": "2026-09-05 A800 80GB / ComfyUI 0.34.0：768x1344 39 帧超到 1080x1920，3B 39.6s、7B 42.1s，尺寸帧数音轨都对，并人眼比过 lanczos / 3B / 7B 三份局部（裙子系带的编织、逆光发丝）",
    "bindings_verified": true
  },
  "load": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": ""
    }
  },
  "comp": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["load", 0]
    }
  },
  "resize": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["comp", 0],
      "scale_method": "lanczos",
      "resize_type": "scale dimensions",
      "resize_type.width": 1080,
      "resize_type.height": 1920,
      "resize_type.crop": "center"
    }
  },
  "pre": {
    "class_type": "SeedVR2Preprocess",
    "inputs": {
      "resized_images": ["resize", 0]
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "seedvr2_7b_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "seedvr2_ema_vae_fp16.safetensors"
    }
  },
  "encode": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": ["pre", 0],
      "vae": ["vae", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "cond": {
    "class_type": "SeedVR2Conditioning",
    "inputs": {
      "model": ["unet", 0],
      "vae_conditioning": ["encode", 0]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0],
      "seed": 0,
      "steps": 1,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "latent_image": ["encode", 0],
      "denoise": 1
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["sampler", 0],
      "vae": ["vae", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "postp": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": {
      "images": ["decode", 0],
      "original_resized_images": ["resize", 0],
      "color_correction_method": "none"
    }
  },
  "create": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["postp", 0],
      "audio": ["comp", 1],
      "fps": ["comp", 2],
      "bit_depth": ["comp", 3]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create", 0],
      "filename_prefix": "studio/upscaled",
      "format": "auto",
      "codec": "auto"
    }
  }
}
