{
  "$id": "https://github.com/sunsheng/video-studio/schema/prompt_pack.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "studio.submit_stage 在阶段 prompt_pack 接受的 outputs 形状。顶层键固定为 prompt_pack。",
  "properties": {
    "prompt_pack": {
      "additionalProperties": true,
      "description": "逐镜头 prompt 与 ComfyUI workflow 参数",
      "properties": {
        "core_model_family": {
          "description": "核心模型系列",
          "type": "string"
        },
        "identity_lock": {
          "additionalProperties": true,
          "description": "身份锁。从视觉资产的 consistency_lock **原样复制**——提交时会逐字比对，也会逐镜检查每条 positive 是不是真的带上了它",
          "properties": {
            "character": {
              "description": "与分镜 character_lock.identity_lock、视觉资产 consistency_lock.character 逐字相同的那段外观描述。每一镜的 positive 里必须原样出现",
              "type": "string"
            },
            "environment": {
              "description": "环境锁定，同样逐字复用",
              "type": "string"
            },
            "typography": {
              "description": "排版禁止项",
              "type": "string"
            }
          },
          "required": [
            "character"
          ],
          "type": "object"
        },
        "shots": {
          "description": "逐镜头参数",
          "items": {
            "additionalProperties": true,
            "description": "一个镜头的 prompt",
            "properties": {
              "audio": {
                "description": "这一镜要出的声音：环境声、拟音、对白（放引号并注明语言）、音乐。核心系列多为音视频联合生成，留空等于放弃原生音频。内容照抄分镜的 audio，不要在这里另编",
                "type": "string"
              },
              "duration_seconds": {
                "description": "时长（秒）。按帧数收时长的基线用 length_frames",
                "minimum": 0.1,
                "type": "number"
              },
              "first_frame": {
                "description": "首帧的 asset_id。**只有 head: image 用**",
                "type": "string"
              },
              "fps": {
                "description": "帧率",
                "type": "integer"
              },
              "guides": {
                "description": "把某个素材锚在某一帧上。**镜头之间接不接得住靠它**——把上一镜的尾段锚在本镜第 0 帧，模型生成的是两条流的续接，比只在提示词里说「接上一镜」有效。head: image 只能锚首帧（0）或尾帧（-1）",
                "items": {
                  "additionalProperties": true,
                  "description": "一个锚点",
                  "properties": {
                    "asset_id": {
                      "description": "visual_assets 登记过的产物 id",
                      "type": "string"
                    },
                    "at_frame": {
                      "description": "锚在第几帧。负数从末尾倒数，-1 是最后一帧",
                      "type": "integer"
                    },
                    "kind": {
                      "description": "锚什么。clip 是视频片段，长度吃 17k+5 网格",
                      "enum": [
                        "image",
                        "clip",
                        "audio"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "at_frame",
                    "asset_id"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "head": {
                "description": "这一镜用哪种生成方式。**片段化的系列用它代替 workflow**：reference（挂参考，锁身份/风格，起幅由模型定）、image（给首尾帧，锁构图与运动轨迹）。取值由 studio.schema 按这台机器的片段库给出",
                "type": "string"
              },
              "height": {
                "description": "高",
                "type": "integer"
              },
              "last_frame": {
                "description": "尾帧的 asset_id。**只有 head: image 用**，可不给",
                "type": "string"
              },
              "length_frames": {
                "description": "帧数。有的基线按秒收时长，用 duration_seconds",
                "type": "integer"
              },
              "negative": {
                "description": "负向提示词。**不是每条基线都支持**——不支持的基线上写了会被**挡下**（提交时按能力面对账，报 schema_violation），该把约束改写成正向的连续性约束（「一镜到底」「主体全程居中」「不切场景」）。先看能力卡",
                "type": "string"
              },
              "positive": {
                "description": "正向提示词。一条提示词只描述**一个可读镜头**：一个主体、一个可见动作、一个受控环境、一个运镜。句首放最重要的视觉元素。禁止 cinematic / 电影感 / 史诗般 / 大片质感 / 4K / 高质量这类对模型无效的词",
                "type": "string"
              },
              "references": {
                "description": "挂给这一镜的视觉资产。**只有 head: reference 吃它**——身份、空间、运动各挂一路，比在 positive 里反复描述外观有效得多。上限按介质分：图 9、视频 3、音频 3",
                "items": {
                  "additionalProperties": true,
                  "description": "一条参考",
                  "properties": {
                    "asset_id": {
                      "description": "visual_assets 登记过的产物 id。写不存在的会被挡下并列出可用的",
                      "type": "string"
                    },
                    "kind": {
                      "description": "介质",
                      "enum": [
                        "image",
                        "video",
                        "audio"
                      ],
                      "type": "string"
                    },
                    "with_audio": {
                      "description": "视频参考是否连音轨一起挂。只有 kind: video 能用",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "asset_id"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "seed": {
                "description": "随机种子。固定以便复现",
                "type": "integer"
              },
              "shot_id": {
                "description": "对应分镜的 shot_id",
                "type": "string"
              },
              "width": {
                "description": "宽",
                "type": "integer"
              },
              "workflow": {
                "description": "整图基线名，例如 ltx2_5/t2v。**只有走整图基线的系列用它**（ltx2_5 / wan2_2 等）。片段化的系列改用 head + references + guides，写 workflow 会被挡下。调 studio.schema 看这台机器给的是哪一种",
                "type": "string"
              }
            },
            "required": [
              "shot_id",
              "positive",
              "width",
              "height",
              "length_frames",
              "fps"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "core_model_family",
        "identity_lock",
        "shots"
      ],
      "type": "object"
    }
  },
  "required": [
    "prompt_pack"
  ],
  "title": "prompt_pack 阶段产物",
  "type": "object"
}
