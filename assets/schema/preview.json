{
  "$id": "https://github.com/sunsheng/video-studio/schema/preview.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "studio.submit_stage 在阶段 preview 接受的 outputs 形状。顶层键固定为 preview。",
  "properties": {
    "preview": {
      "additionalProperties": true,
      "description": "480p 预览结果登记（由控制面产出）。花贵的正式渲染之前，先出便宜的低分辨率预览让人工确认构图与内容——帧数/时长不变，只降分辨率。",
      "properties": {
        "shots": {
          "description": "每镜头一条",
          "items": {
            "additionalProperties": true,
            "description": "一镜预览结果",
            "properties": {
              "duration_seconds": {
                "description": "实际时长",
                "type": "number"
              },
              "height": {
                "description": "预览高度（480 短边缩放后）",
                "type": "integer"
              },
              "node": {
                "description": "承载的 ComfyUI 节点",
                "type": "string"
              },
              "path": {
                "description": "预览文件的 bundle 内相对路径，media/preview/ 下",
                "type": "string"
              },
              "prompt_id": {
                "description": "ComfyUI 的 prompt_id，用于追溯",
                "type": "string"
              },
              "shot_id": {
                "description": "镜头标识",
                "type": "string"
              },
              "width": {
                "description": "预览宽度（480 短边缩放后）",
                "type": "integer"
              }
            },
            "required": [
              "shot_id",
              "node",
              "prompt_id",
              "path"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "shots"
      ],
      "type": "object"
    }
  },
  "required": [
    "preview"
  ],
  "title": "preview 阶段产物",
  "type": "object"
}
