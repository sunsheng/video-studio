{
  "$id": "https://github.com/sunsheng/video-studio/schema/review.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "studio.submit_stage 在阶段 review 接受的 outputs 形状。顶层键固定为 review。",
  "properties": {
    "review": {
      "additionalProperties": true,
      "description": "验收报告。**技术验收**由控制面产出（下面的 checks 与 passed）；**内容验收**由 Agent 事后用 studio.self_review 补上（content_review），它不改变 passed——片子已经出来了，内容评价改变不了它是否完整",
      "properties": {
        "checks": {
          "description": "逐项检查",
          "items": {
            "additionalProperties": true,
            "description": "一项",
            "properties": {
              "detail": {
                "description": "依据。必须来自实际媒体元数据，不能是推断",
                "type": "string"
              },
              "kind": {
                "description": "这一项是谁判的：technical 来自 ffprobe 实测，content 来自内容自评",
                "enum": [
                  "technical",
                  "content"
                ],
                "type": "string"
              },
              "name": {
                "description": "检查项",
                "type": "string"
              },
              "passed": {
                "description": "结果",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "kind",
              "passed",
              "detail"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "content_review": {
          "additionalProperties": true,
          "description": "内容自评。由 studio.self_review 写入，Agent 不在这里提交",
          "properties": {
            "items": {
              "description": "逐维度一条",
              "items": {
                "additionalProperties": true,
                "description": "一条自评",
                "properties": {
                  "at_seconds": {
                    "description": "可指认的时间点（秒）",
                    "minimum": 0.0,
                    "type": "number"
                  },
                  "criterion": {
                    "description": "评价维度。固定五条，不可增删",
                    "enum": [
                      "hook",
                      "information_density",
                      "pacing",
                      "consistency",
                      "brief_metrics"
                    ],
                    "type": "string"
                  },
                  "evidence": {
                    "description": "在那个时间点上看见/听见了什么，以及它为什么支持这个结论",
                    "type": "string"
                  },
                  "verdict": {
                    "description": "结论",
                    "enum": [
                      "met",
                      "partially_met",
                      "not_met"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "criterion",
                  "verdict",
                  "at_seconds",
                  "evidence"
                ],
                "type": "object"
              },
              "minItems": 5,
              "type": "array"
            },
            "summary": {
              "description": "一句话：最强的一点和最弱的一点",
              "type": "string"
            }
          },
          "required": [
            "items",
            "summary"
          ],
          "type": "object"
        },
        "passed": {
          "description": "技术验收是否通过。只看 kind 为 technical 的检查项",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "type": "object"
    }
  },
  "required": [
    "review"
  ],
  "title": "review 阶段产物",
  "type": "object"
}
